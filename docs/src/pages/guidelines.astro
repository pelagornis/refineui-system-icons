---
import {
  Container,
  Divider,
  Link,
  Stack,
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
  Text,
} from '@refineui/react';
import Layout from '../layouts/Layout.astro';
import availability from '../data/availability.json';
import { SUPPORTED_SIZES, TOTAL_ICONS } from '../data/icons';

const platformLabel: Record<string, string> = {
  react: 'React',
  'react-native': 'React Native',
  web: 'Web',
  cdn: 'CDN',
  ios: 'iOS',
  android: 'Android',
  flutter: 'Flutter',
};

const platformRows = Object.entries(availability.platforms).map(([id, info]) => ({
  label: platformLabel[id] ?? id,
  sizes: info.sizes.join(', '),
}));

const androidMissing = availability.platforms.android.unsupportedSlugs;

const strokeWeight = [
  ['16', '0.65'],
  ['20', '1.083'],
  ['24', '1.3'],
  ['28', '1.517'],
  ['32', '1.733'],
  ['48', '2.6'],
];

const squareRadius = [
  ['16', '1'],
  ['20', '1.667'],
  ['24', '2'],
  ['28', '2.333'],
  ['32', '2.667'],
  ['48', '4'],
];

const addSquareRadius = [
  ['16', '2'],
  ['24', '3'],
  ['32', '4'],
  ['48', '6'],
];
const filePattern = 'assets/{Category}/svg/ic_refineui_{slug}_{size}_{regular|filled}.svg';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<Layout
  title="Guidelines · RefineUI System Icons"
  description="Naming, stroke, corner radius, size, and color rules for RefineUI System Icons."
  current="guidelines"
>
  <Container padding="sizeLarge" className="docs-shell">
    <Stack direction="column" gap="sizeLarge" className="docs-prose py-refineui-size-xx-large">
      <Stack direction="column" gap="sizeSmall">
        <Text variant="displaySm" as="h1">Guidelines</Text>
        <Text variant="bodyLg" as="p" className="text-refineui-alias-foreground-secondary">
          How the {TOTAL_ICONS} icons are named, drawn, sized, and colored. The measurements below
          are observations from representative glyphs—not universal tokens for every icon.
        </Text>
      </Stack>

      <Stack direction="column" gap="sizeLarge">
        <Stack direction="column" gap="sizeSmall">
          <Text variant="headingSm" as="h2">Naming</Text>
          <img
            class="docs-figure"
            src={`${base}guideline/naming.svg`}
            alt="How a slug becomes a React component name, an Android drawable, and a font glyph."
            width="1102"
            height="378"
          />
          <Text variant="bodyMd" as="p" className="text-refineui-alias-foreground-secondary">
            Use a kebab-case slug with no underscores. Source files live in a category folder,
            followed by <code>svg/</code>.
          </Text>
          <Text variant="bodyMd" as="p" className="text-refineui-alias-foreground-secondary">
            <code>assets/Local language/svg/ic_refineui_local-language_24_regular.svg</code>
          </Text>
          <Text variant="bodyMd" as="p" className="text-refineui-alias-foreground-secondary">
            Pattern: <code>{filePattern}</code>.
            Regular and filled are two treatments of one slug. In the icon fonts, they intentionally
            share a codepoint in separate font files, so names within one treatment never collide.
          </Text>
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>Platform</TableHead>
                <TableHead>Identifier</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              <TableRow>
                <TableCell>Slug, metadata, CDN</TableCell>
                <TableCell><code>local-language</code></TableCell>
              </TableRow>
              <TableRow>
                <TableCell>React · React Native · Web</TableCell>
                <TableCell><code>LocalLanguage</code> / <code>LocalLanguageFilled</code></TableCell>
              </TableRow>
              <TableRow>
                <TableCell>iOS</TableCell>
                <TableCell><code>.localLanguage24Regular</code></TableCell>
              </TableRow>
              <TableRow>
                <TableCell>Android</TableCell>
                <TableCell><code>@drawable/ic_refineui_local_language_24_regular</code></TableCell>
              </TableRow>
              <TableRow>
                <TableCell>Flutter</TableCell>
                <TableCell><code>RefineUIIcons.local_language_24_regular</code></TableCell>
              </TableRow>
              <TableRow>
                <TableCell>CDN path</TableCell>
                <TableCell><code>icons/24/local-language-regular.svg</code></TableCell>
              </TableRow>
            </TableBody>
          </Table>
        </Stack>

        <Divider />

        <Stack direction="column" gap="sizeSmall">
          <Text variant="headingSm" as="h2">Stroke</Text>
          <img
            class="docs-figure"
            src={`${base}guideline/stroke.svg`}
            alt="Stroke weight of 1.3 at 24, called out on the grid."
            width="1102"
            height="532"
          />
          <Text variant="bodyMd" as="p" className="text-refineui-alias-foreground-secondary">
            Draw the outline as a filled shape, not with an SVG <code>stroke</code>. The regular 24px
            assets paint fills only; <code>panel-left</code>, for example, declares <code>stroke="none"</code>.
            Use <code>fill-rule="evenodd"</code> to cut holes such as those in Accessibility.
          </Text>
          <Text variant="bodyMd" as="p" className="text-refineui-alias-foreground-secondary">
            At 24px, Square’s outline is 1.3px wide: its outer edge is at 4 and its inner edge at
            5.3. From 20px upward, it scales with the artboard (<code>size × 1.3 / 24</code>). At 16px,
            it is a tighter 0.65px. Square has no 12px asset, so 12px is omitted. Avoid substituting
            a 1.5px stroke.
          </Text>
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>Size</TableHead>
                <TableHead>Stroke</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              {
                strokeWeight.map(([size, width]) => (
                  <TableRow>
                    <TableCell><code>{size}</code></TableCell>
                    <TableCell><code>{width}</code></TableCell>
                  </TableRow>
                ))
              }
            </TableBody>
          </Table>
        </Stack>

        <Divider />

        <Stack direction="column" gap="sizeSmall">
          <Text variant="headingSm" as="h2">Corner radius</Text>
          <img
            class="docs-figure"
            src={`${base}guideline/cornerradius.svg`}
            alt="Corner radius called out on a person glyph and a mail glyph."
            width="1102"
            height="426"
          />
          <Text variant="bodyMd" as="p" className="text-refineui-alias-foreground-secondary">
            Corner radius is chosen per glyph. Square has no 12px asset, so that size is omitted.
            From 20px upward, Square regular’s outer radius is <code>size / 12</code>. At 16px it is
            1px, slightly tighter than that ratio.
          </Text>
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>Size</TableHead>
                <TableHead>Square outer radius</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              {
                squareRadius.map(([size, radius]) => (
                  <TableRow>
                    <TableCell><code>{size}</code></TableCell>
                    <TableCell><code>{radius}</code></TableCell>
                  </TableRow>
                ))
              }
            </TableBody>
          </Table>
          <Text variant="bodyMd" as="p" className="text-refineui-alias-foreground-secondary">
            A glyph can use more than one radius: Square 24’s inner ring has a 0.7px radius.
            Add-square is a separate construction. Its measured outer radii are 2px at 16, 3px at 24,
            4px at 32, and 6px at 48; 20px and 28px were not measured.
          </Text>
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>Size</TableHead>
                <TableHead>Add-square outer radius</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              {
                addSquareRadius.map(([size, radius]) => (
                  <TableRow>
                    <TableCell><code>{size}</code></TableCell>
                    <TableCell><code>{radius}</code></TableCell>
                  </TableRow>
                ))
              }
            </TableBody>
          </Table>
        </Stack>

        <Divider />

        <Stack direction="column" gap="sizeSmall">
          <Text variant="headingSm" as="h2">Size</Text>
          <img
            class="docs-figure"
            src={`${base}guideline/sizes.svg`}
            alt="The same house glyph drawn at 12, 16, 20, 24, 28, 32, and 48."
            width="1102"
            height="532"
          />
          <Text variant="bodyMd" as="p" className="text-refineui-alias-foreground-secondary">
            The component <code>size</code> prop defaults to 24 and accepts {SUPPORTED_SIZES.join(', ')}.
            Prefer the asset drawn for the target size. Scaling a 24px glyph in CSS changes its intended
            weight and corner treatment.
          </Text>
          <Text variant="bodyMd" as="p" className="text-refineui-alias-foreground-secondary">
            12px ships in React, React Native, web, iOS, Flutter, and GPUI. The CDN and Android packages
            do not include it. Android also omits {androidMissing.length} icons: {androidMissing.join(', ')}.
          </Text>
          <Table>
            <TableHeader>
              <TableRow>
                <TableHead>Platform</TableHead>
                <TableHead>Sizes</TableHead>
              </TableRow>
            </TableHeader>
            <TableBody>
              {
                platformRows.map((row) => (
                  <TableRow>
                    <TableCell>{row.label}</TableCell>
                    <TableCell><code>{row.sizes}</code></TableCell>
                  </TableRow>
                ))
              }
            </TableBody>
          </Table>
        </Stack>

        <Divider />

        <Stack direction="column" gap="sizeSmall">
          <Text variant="headingSm" as="h2">Theme</Text>
          <div class="docs-figures">
            <img
              src={`${base}guideline/themeregular.svg`}
              alt="Regular house, one black fill on a light panel."
              width="546"
              height="314"
            />
            <img
              src={`${base}guideline/themefilled.svg`}
              alt="Filled house, one black fill on a light panel."
              width="546"
              height="314"
            />
          </div>
          <Text variant="bodyMd" as="p" className="text-refineui-alias-foreground-secondary">
            The set is single-color. Source SVG fills are black (<code>black</code>, and <code>#000000</code>
            on <code>panel-left</code>). React, React Native, and web default to <code>currentColor</code>,
            so icons inherit nearby text color. iOS imagesets are templates, while Android vectors use black
            fills for app tinting. GPUI rasterizes the embedded SVG, so transform <code>Icon::svg()</code> in
            a custom asset pipeline when you need another color. Do not introduce a second glyph color.
          </Text>
          <Text variant="bodyMd" as="p" className="text-refineui-alias-foreground-secondary">
            The light and dark toggle on this site only changes the page. It stores <code>refineui-docs-theme</code> and sets <code>data-theme</code>. Icons still inherit
            the current text color. There is no separate dark glyph.
          </Text>
        </Stack>

        <Divider />

        <Text variant="bodyMd" as="p">
          <Link href={`${import.meta.env.BASE_URL}usage`}>Install and platform setup</Link>
        </Text>
      </Stack>
    </Stack>
  </Container>
</Layout>
